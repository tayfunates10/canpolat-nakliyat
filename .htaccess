Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule LiteSpeed>
  # Ana sayfada eski HTML snapshot/page-cache devreye girmesin.
  CacheDisable public /
  CacheDisable private /
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Kök istek her koşulda doğrudan PHP girişine gider; index.html DirectoryIndex değildir.
  RewriteRule ^$ index.php [L]

  # Eski statik index.html dışarıdan çağrılırsa doğrudan yeni PHP girişine yönlendir.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ /index.php [R=302,L,NE]

  # PHP'nin kullandığı ham şablon web üzerinden hiçbir koşulda görüntülenemez.
  RewriteRule ^index-template\.html$ - [F,L,NC]

  # Eski hero dosyaları tamamen emekli edildi. Sunucuda/browser dışında bir kopya kalsa bile servis etme.
  RewriteRule ^assets/images/hero-canpolat(?:-mobil)?\.webp$ - [G,L,NC]
</IfModule>

# HTTPS yönlendirmesi, canpolatnakliyat.com için geçerli SSL sertifikası
# doğrulandıktan sonra aşağıdaki koşul ve kural etkinleştirilmelidir.
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # Ana sayfanın HTML/PHP çıktısı tarayıcı veya ara cache tarafından saklanmaz.
  <FilesMatch "^(index\.php|index\.html)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

ErrorDocument 404 /404.html
