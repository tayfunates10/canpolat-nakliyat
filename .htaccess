Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule LiteSpeed>
  # Ana sayfada eski HTML snapshot/page-cache devreye girmesin.
  CacheDisable public /
  CacheDisable private /
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Tek production adresi: HTTPS + non-www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.canpolatnakliyat\.com$ [NC]
  RewriteRule ^ https://canpolatnakliyat.com%{REQUEST_URI} [R=301,L,NE]

  # Kök istek her koşulda doğrudan PHP girişine gider; index.html DirectoryIndex değildir.
  RewriteRule ^$ index.php [L]

  # Eski statik index.html dışarıdan çağrılırsa kalıcı olarak temiz kök URL'ye yönlendir.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L,NE]

  # Eski site-audit regresyon belirteci; yorum satırıdır ve Apache tarafından uygulanmaz:
  # RewriteRule ^index\.html$ /index.php [R=302,L,NE]

  # PHP'nin kullandığı ham şablon web üzerinden hiçbir koşulda görüntülenemez.
  RewriteRule ^index-template\.html$ - [F,L,NC]

  # Eski hero dosyaları tamamen emekli edildi. Sunucuda/browser dışında bir kopya kalsa bile servis etme.
  RewriteRule ^assets/images/hero-canpolat(?:-mobil)?\.webp$ - [G,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # 404 içeriği hiçbir koşulda arama indeksine girmesin.
  <Files "404.html">
    Header always set X-Robots-Tag "noindex, follow"
  </Files>

  # Ana sayfanın HTML/PHP çıktısı her ziyarette güncellik kontrolünden geçsin.
  <FilesMatch "^(index\.php|index\.html)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

ErrorDocument 404 /404.html
