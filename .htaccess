Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule LiteSpeed>
  CacheDisable public /
  CacheDisable private /
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Tek canonical adres: HTTPS + www alan adı.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.canpolatnakliyat\.com$ [NC]
  RewriteRule ^ https://www.canpolatnakliyat.com%{REQUEST_URI} [R=301,L,NE]

  # Açık index dosyalarını temiz kök adrese yönlendir.
  RewriteCond %{THE_REQUEST} \s/+index\.(?:php|html)(?:[?\s]) [NC]
  RewriteRule ^index\.(?:php|html)$ / [R=301,L,NE]

  # Ortak CSS/JS dosyalarını mevcut ana dosyanın sonuna kontrollü canlı
  # düzeltmeleri ekleyen PHP katmanından sun. URL değişmez; tüm sayfalar aynı
  # anda güncellenir ve R8 kaynak dosyalarına dokunulmaz.
  RewriteRule ^css/style\.css$ css/style-live.php [L]
  RewriteRule ^js/script\.js$ js/script-live.php [L]

  # Kök isteği production PHP girişine gider.
  RewriteRule ^$ index.php [L]

  # PHP tarafından okunan ham şablon web üzerinden görüntülenemez.
  RewriteRule ^index-template\.html$ - [F,L,NC]

  # Eski hero URL'leri kalıcı olarak emekli edilmiştir.
  RewriteRule ^assets/images/hero-canpolat(?:-mobil)?\.webp$ - [G,L,NC]

  # Hosting varsayılan hata gövdesini atlayarak markalı 404 sayfasını doğru durum koduyla sun.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always unset X-Okur-Htaccess
  Header always set X-Hero-Version "R8-11"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'none'; upgrade-insecure-requests"

  <Files "404.html">
    Header always set X-Robots-Tag "noindex, follow"
  </Files>

  <FilesMatch "^(index\.php|index\.html|index-template\.html)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

ErrorDocument 404 /404.html
